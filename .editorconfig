root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
# Matches [tool.ruff] line-length in pyproject.toml.
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2

[*.toml]
# pyproject.toml is indented with four spaces.
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

{
  "mcpServers": {
    "mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sapran/aleph-mcp.git@9bd04af0ec7dfcfb61478b0e568c0d79bd8440be",
        "aleph-mcp"
      ],
      "env": {
        "ALEPHCLIENT_HOST": "!printf %s \"$ALEPHCLIENT_HOST\"",
        "ALEPHCLIENT_API_KEY": "!k=$(security find-generic-password -s \"aleph-mcp:$ALEPHCLIENT_HOST\" -a \"$USER\" -w 2>/dev/null); printf %s \"${k:-aleph-mcp:keychain-miss}\""
      }
    }
  }
}

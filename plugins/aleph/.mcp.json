{
  "mcpServers": {
    "mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sapran/aleph-mcp.git@317d4bb021c14bb3518d946b035ebda310cf6a28",
        "aleph-mcp"
      ],
      "env": {
        "ALEPHCLIENT_HOST": "!printf %s \"$ALEPHCLIENT_HOST\"",
        "ALEPHCLIENT_API_KEY": "!security find-generic-password -s aleph-mcp -a \"$USER\" -w 2>/dev/null || printf %s \"$ALEPHCLIENT_API_KEY\""
      }
    }
  }
}
